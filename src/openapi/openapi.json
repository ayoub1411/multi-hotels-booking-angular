  "components": {
    "schemas": {
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "businessErrorCode": {
            "type": "integer",
            "format": "int32"
          },
          "businessErrorDescription": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "validationErrors": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RoomRequest": {
        "required": [
          "numberOfRooms",
          "price",
          "surface"
        ],
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "format": "double"
          },
          "surface": {
            "minimum": 10,
            "type": "number",
            "format": "double"
          },
          "numberOfRooms": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "HotelDto": {
        "required": [
          "address",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "stars": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "city": {
            "$ref": "#/components/schemas/CityDto"
          },
          "address": {
            "type": "string"
          },
          "imageName": {
            "type": "string"
          }
        }
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "surface": {
            "type": "number",
            "format": "double"
          },
          "numberOfRooms": {
            "type": "integer",
            "format": "int32"
          },
          "hotelDto": {
            "$ref": "#/components/schemas/HotelDto"
          },
          "roomImages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomImageDto"
            }
          }
        }
      },
      "RoomImageDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "HotelRequestDto": {
        "required": [
          "address",
          "cityId",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "stars": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "address": {
            "type": "string"
          },
          "cityId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ReservationRequestDto": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AddressDto": {
        "required": [
          "adresse1",
          "codePostale",
          "pays",
          "ville"
        ],
        "type": "object",
        "properties": {
          "adresse1": {
            "type": "string"
          },
          "adresse2": {
            "type": "string"
          },
          "ville": {
            "type": "string"
          },
          "codePostale": {
            "type": "string"
          },
          "pays": {
            "type": "string"
          }
        }
      },
      "ClientResponse": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "image": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "phoneNumber": {
            "type": "string"
          }
        }
      },
      "ReservationResponseDto": {
        "type": "object",
        "properties": {
          "client": {
            "$ref": "#/components/schemas/ClientResponse"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "checkInDate": {
            "type": "string",
            "format": "date"
          },
          "checkOutDate": {
            "type": "string",
            "format": "date"
          },
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "CANCELLED",
              "COMPLETED"
            ]
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RegistrationRequest": {
        "required": [
          "address",
          "confirmPassword",
          "dateOfBirth",
          "email",
          "firstname",
          "lastname",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "firstname": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "lastname": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 2147483647,
            "minLength": 8,
            "type": "string"
          },
          "confirmPassword": {
            "maxLength": 2147483647,
            "minLength": 8,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "phoneNumber": {
            "pattern": "^[0-9]{10}$",
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 2147483647,
            "minLength": 8,
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "acces-token": {
            "type": "string"
          },
          "refresh-token": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Securing project with JWT",
        "in": "header",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
